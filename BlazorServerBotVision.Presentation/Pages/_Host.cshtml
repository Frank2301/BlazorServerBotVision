@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace BlazorServerBotVision.Presentation.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />

   <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">

    <link rel="stylesheet" href="_content/BlazorServerBotVision.UI/css/open-iconic/font/css/open-iconic-bootstrap.min.css" />
    <link href="_content/BlazorServerBotVision.UI/css/site.css" rel="stylesheet" />

    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>

<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            Ein Fehler ist aufgetreten. Die Anwendung reagiert möglicherweise nicht mehr.
        </environment>
        <environment include="Development">
            Ein nicht behandelter Fehler ist aufgetreten. Siehe Browser-Entwicklertools für Details.
        </environment>
        <a href="" class="reload">Neu laden</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>
