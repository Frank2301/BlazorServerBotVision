@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h5 class="card-title">Stelle Deine Anfrage</h5>

        <textarea class="form-control mb-2"
                  rows="5"
                  placeholder="@($"Gib Deine Frage ein, {UserFirstName}…")"
                  value="@Prompt"
                  @oninput="OnInput"
                  @onkeydown="OnKeyDownHandler"
                  disabled="@IsBusy">
    </textarea>

        <button type="button"
                class="btn btn-primary w-100"
                @onclick="OnAsk"
                disabled="@(IsBusy || HasReachedLimit || string.IsNullOrWhiteSpace(Prompt))">
            @if (IsBusy)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            }
            else
            {
                <text>senden &amp; speichern</text>
            }
        </button>

        @if (HasReachedLimit)
        {
            <div class="alert alert-warning mt-2">
                Tageslimit erreicht.
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Prompt { get; set; } = "";
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool HasReachedLimit { get; set; }
    [Parameter] public string UserFirstName { get; set; } = "";
    [Parameter] public EventCallback<string> PromptChanged { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public EventCallback OnAsk { get; set; }

    private Task OnInput(ChangeEventArgs e)
      => PromptChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private Task OnKeyDownHandler(KeyboardEventArgs e)
      => OnKeyDown.InvokeAsync(e);
}