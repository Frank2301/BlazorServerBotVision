@page "/chat"
@attribute [Authorize]
@using BlazorServerBotVision.UI.Components
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using BlazorServerBotVision.Application.DTOs
@using BlazorServerBotVision.Application.Interfaces
@using BlazorServerBotVision.UI.Helpers

<h3 class="text-center">Chatbot</h3>

<SpeechControls Language="@language"
                IsBusy="@isBusy"
                IsDictating="@isDictating"
                LiveText="@liveText"
                SpeechError="@speechError"
                EnableSpeak="@enableSpeak"
                OnLanguageChanged="lang => language = lang"
                OnStartDictation="StartDictation"
                OnToggleContinuous="ToggleContinuous"
                OnEnableSpeakChanged="b => enableSpeak = b" />

<div class="container">
  <div class="row">
    <div class="col-md-6">
            <ChatInput Prompt="@prompt"
                       PromptChanged="p => prompt = p"
                       IsBusy="@isBusy"
                       HasReachedLimit="@HasReachedDailyLimit"
                       UserFirstName="@userFirstName"
                       OnKeyDown="HandleKeyDown"
                       OnAsk="HandleAsk" />
    </div>
    <div class="col-md-6">
      <ChatHistory History="@history"
                   SelectedId="@selectedId"
                   OnDelete="Delete"
                   OnSelect="id => selectedId = id"
                   ScrollTarget="historyDiv" />
    </div>
  </div>
</div>

@code {
  private ElementReference historyDiv;
}
